# PulseGuard Environment Configuration

# Service Settings
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=pulseguard_super_secret_jwt_key_2026

# Database Settings (PostgreSQL / TimescaleDB)
DB_TYPE=sqlite  # Set to 'postgres' for TimescaleDB production
DATABASE_URL=sqlite+aiosqlite:///./pulseguard.db
# DATABASE_URL=postgresql+asyncpg://postgres:pulseguard_password@localhost:5432/pulseguard

# Redis Broker (for high-frequency telemetry streams)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=pulseguard-data
STORAGE_LOCAL_DIR=./storage

# Telegram Paramedic Bot Configuration
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
PARAMEDIC_DEFAULT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
TELEGRAM_WEBHOOK_URL=https://pulseguard.health/api/v1/telegram/webhook
